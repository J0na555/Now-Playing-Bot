# Your uid from spotify-github-profile.kittinanx.com (the one already in your README embed)
SPOTIFY_UID=

# From @BotFather when you created your bot
TELEGRAM_BOT_TOKEN=

# Your channel's chat id. For public channels you can use @yourchannelname.
# For private channels, it's a negative number like -100xxxxxxxxxx
TELEGRAM_CHAT_ID=

# The message_id of the ONE message you post + pin once, then keep editing forever.
# See README.md for how to get this.
TELEGRAM_MESSAGE_ID=

# v2 — YouTube now playing. From your Upstash Redis REST database (https://console.upstash.com):
# URL is the REST endpoint, TOKEN is the REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared with the Chrome extension (extension/config.js). Any random string —
# keep it SEPARATE from CRON_SECRET.
PUSH_SECRET=

# Optional. How fresh YouTube state must be (ms) for the YouTube card to show.
# Default 180000 and MUST exceed 2x the scheduler beat — with the 1-minute beat
# keep it at 180000 or higher.
YT_FRESHNESS_MS=
