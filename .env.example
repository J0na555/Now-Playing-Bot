# Your uid from spotify-github-profile.kittinanx.com (the one already in your README embed)
SPOTIFY_UID=

# From @BotFather when you created your bot
TELEGRAM_BOT_TOKEN=

# Your channel's chat id. For public channels you can use @yourchannelname.
# For private channels, it's a negative number like -100xxxxxxxxxx
TELEGRAM_CHAT_ID=

# The message_id of the ONE message you post + pin once, then keep editing forever.
# See README.md for how to get this.
TELEGRAM_MESSAGE_ID=

# Optional: a random string you make up, used to stop randoms from hitting your
# /api/poll endpoint. Set the same value in your external cron scheduler's
# Authorization header as "Bearer <this value>".
CRON_SECRET=
